
# Application Settings
APP_NAME="XenX"
APP_VERSION="1.0.0"
DEBUG="False"
ENVIRONMENT="dev"

# Seeder Settings (for development)
RUN_SEEDER_ON_STARTUP="False"
CLEAR_DB_BEFORE_SEED="True"

# Authentication Settings
SECRET_KEY="a-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="60"
REFRESH_TOKEN_EXPIRE_DAYS="30"

# API URLs
API_BASE_URL="http://your-api.com"

# Frontend URLs
FRONTEND_BASE_URL="https://your-frontend-domain.com"
FRONTEND_LOGIN_URL="https://your-frontend-domain.com/login"
FRONTEND_REGISTER_URL="https://your-frontend-domain.com/register"
ACCEPT_INVITATION_URL="https://your-frontend-domain.com/accept-invitation"

# Email Settings
FROM_EMAIL="noreply@your-domain.com"
SENDGRID_API_KEY="your-sendgrid-api-key"

# OAuth Settings
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"

GOOGLE_AUTH_URI="https://accounts.google.com/o/oauth2/auth"
GOOGLE_TOKEN_URI="https://oauth2.googleapis.com/token"
GOOGLE_USERINFO_URI="https://www.googleapis.com/oauth2/v3/userinfo"

# File Storage
UPLOAD_DIR="uploads"

# Database Settings
USERS_DATABASE_URL="sqlite+aiosqlite:///./users.db"

# Microservices
CRM_DATABASE_URL="sqlite+aiosqlite:///./crm.db"
TAX_PLANNER_DATABASE_URL="sqlite+aiosqlite:///./tax_planner.db"

# Redis Settings for caching, rate limiting, and session management
REDIS_URL="redis://localhost:6379/0"
RATE_LIMIT_DEFAULT="100"
USE_REDIS_CACHE="False"

# AWS Settings

# Security Settings

# -------------------------------------------------
# AI Chat Settings (Feature Flag & Configuration)
# -------------------------------------------------
# Toggle AI chat feature (do not include router if false)
ENABLE_AI_CHAT="False"
# If true, tools/actions will not perform side effects (Phase 1 simulation)
SIMULATION_MODE="True"
# Model provider abstraction key (e.g., gemini, openai, anthropic, local)
MODEL_PROVIDER="gemini"
# Underlying model name (free tier or specific variant)
MODEL_NAME="gemini-free"
# Maximum model output tokens (safeguard)
MAX_TOKENS_MODEL="2048"
# General request rate limit config
RATE_LIMIT_REQUESTS_PER_WINDOW="60"
RATE_LIMIT_WINDOW_SECONDS="300"
# Action execution & proposal quotas
RATE_LIMIT_ACTIONS_PER_HOUR="10"
ACTION_PROPOSALS_PER_HOUR="20"
# Summarization thresholds
SUMMARY_TRIGGER_TURNS="15"
SUMMARY_KEEP_RECENT_TURNS="12"
# Cooldown before a re-invite to same email is allowed (seconds)
INVITE_REINVITE_INTERVAL_SECONDS="3600"
# Log verbosity for AI chat module
LOG_LEVEL="info"